# Claim: at the G-study counts of a balanced crossed p×i×r random design,
#   1 - G = (EMS_pi + EMS_pr - EMS_pir) / EMS_p,
# so under normality (1 - Ĝ)/(1 - G) = [L/E(L)] / [MS_p/EMS_p] with
# L = MS_pi + MS_pr - MS_pir, which is approximately F(ν, n_p - 1) with the
# Satterthwaite ν = L² / Σ_j (c_j MS_j)²/df_j. This supports the interval
#   G ∈ [1 - (1-Ĝ)/F_{α/2}, 1 - (1-Ĝ)/F_{1-α/2}],  F ~ F(ν̂, n_p - 1),
# whose calibration the coverage study must establish (the F law is approximate).
# Plan: salib journal/2026-10-23-g-theory-bootstrap-plan.md.
# Derivation source: EMS from Brennan (2001) as reproduced in CASMA 21 Eq. 71;
# G and δ from their definitions (not from salib's code).
var('np ni nr s_p s_i s_r s_pi s_pr s_ir s_pir')
ems = {
    'p':   s_pir + nr*s_pi + ni*s_pr + ni*nr*s_p,
    'pi':  s_pir + nr*s_pi,
    'pr':  s_pir + ni*s_pr,
    'pir': s_pir,
}
delta = s_pi/ni + s_pr/nr + s_pir/(ni*nr)          # relative error at observed counts
G = s_p / (s_p + delta)
claim = (ems['pi'] + ems['pr'] - ems['pir']) / ems['p']
assert bool((1 - G - claim).simplify_full() == 0), "1 - G identity fails"

# MS_e ~ EMS_e χ²_{df}/df independently: E(L) and Var(L) give the Satterthwaite df.
df = {'p': np-1, 'pi': (np-1)*(ni-1), 'pr': (np-1)*(nr-1), 'pir': (np-1)*(ni-1)*(nr-1)}
EL = ems['pi'] + ems['pr'] - ems['pir']
VarL = 2*ems['pi']^2/df['pi'] + 2*ems['pr']^2/df['pr'] + 2*ems['pir']^2/df['pir']
nu = (2*EL^2/VarL).simplify_full()
nu_hat_form = EL^2 / (ems['pi']^2/df['pi'] + ems['pr']^2/df['pr'] + ems['pir']^2/df['pir'])
assert bool((nu - nu_hat_form).simplify_full() == 0), "Satterthwaite nu form fails"
print("ok: 1-G = (EMS_pi+EMS_pr-EMS_pir)/EMS_p; nu = L^2 / sum MS_j^2/df_j")

# Pinned numeric cases for salib's g_f_interval, at 50 digits with mpmath's
# regularized incomplete beta for the F cdf (independent of statrs).
import os, hashlib, struct, mpmath, sage.version
SALIB = os.environ["SALIB_ROOT"]
mpmath.mp.dps = 50

def f_cdf(x, d1, d2):
    x = mpmath.mpf(x)
    return mpmath.betainc(mpmath.mpf(d1) / 2, mpmath.mpf(d2) / 2, 0, d1 * x / (d1 * x + d2), regularized=True)

def f_quantile(prob, d1, d2):
    lo, hi = mpmath.mpf(0), mpmath.mpf(1)
    while f_cdf(hi, d1, d2) < prob:
        lo, hi = hi, hi * 2
    for _ in range(400):
        mid = (lo + hi) / 2
        if f_cdf(mid, d1, d2) < prob:
            lo = mid
        else:
            hi = mid
    return hi

def interval(c, sizes, alpha):
    p, _, _, pi, pr, _, pir = [mpmath.mpf(float(v)) for v in c]  # exactly the f64 Rust uses
    np_, ni, nr = [mpmath.mpf(v) for v in sizes]
    ms_pi, ms_pr, ms_pir = pir + nr * pi, pir + ni * pr, pir
    ms_p = ms_pi + ms_pr - ms_pir + ni * nr * p
    L = ms_pi + ms_pr - ms_pir
    df_pi, df_pr = (np_ - 1) * (ni - 1), (np_ - 1) * (nr - 1)
    df_pir = df_pi * (nr - 1)
    nu = L**2 / (ms_pi**2 / df_pi + ms_pr**2 / df_pr + ms_pir**2 / df_pir)
    a = mpmath.mpf(float(alpha))
    q_lo, q_hi = f_quantile(a / 2, nu, np_ - 1), f_quantile(1 - a / 2, nu, np_ - 1)
    omg = L / ms_p
    return max(mpmath.mpf(0), 1 - omg / q_lo), max(mpmath.mpf(0), 1 - omg / q_hi), nu

def bits(x):
    return "f64::from_bits(0x%016x)" % struct.unpack('<Q', struct.pack('<d', float(RealField(53)(x))))[0]

CASES = [
    ("0.5528, 0.4417, 0.0074, 0.575, 0.1009, 0.1565, 0.9352", (10, 4, 2), "0.05"),  # Brennan Synthetic No. 3
    ("1, 1, 1, 1, 1, 1, 1", (20, 8, 4), "0.05"),
    ("4, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5", (50, 5, 3), "0.1"),
    ("0.01, 0.1, 0.1, 1, 1, 0.1, 1", (20, 5, 2), "0.05"),     # near-zero G: clipped at 0
]
lines = [
    "// @generated by verify/sage/g_theory_f_interval.sage — do not edit.",
    "// sha256(script) = %s; SageMath %s" % (hashlib.sha256(open(os.path.join(SALIB, "verify", "sage", "g_theory_f_interval.sage"), "rb").read()).hexdigest(), sage.version.version),
    "// F quantiles by bisection on mpmath's regularized incomplete beta, 50 digits.",
    "",
    "/// Components (p, i, r, pi, pr, ir, pir), counts, alpha and the exact interval.",
    "pub struct FIntervalCase {",
    "    pub components: [f64; 7],",
    "    pub sizes: [usize; 3],",
    "    pub alpha: f64,",
    "    pub interval: (f64, f64),",
    "    pub nu: f64,",
    "}",
    "",
    "pub const F_INTERVAL_CASES: &[FIntervalCase] = &[",
]
for comps, sizes, alpha in CASES:
    c = [s.strip() for s in comps.split(",")]
    lo, hi, nu = interval(c, sizes, alpha)
    lines += [
        "    FIntervalCase {",
        "        components: [%s]," % ", ".join(v if "." in v else v + ".0" for v in c),
        "        sizes: [%d, %d, %d]," % sizes,
        "        alpha: %s," % alpha,
        "        interval: (%s, %s)," % (bits(lo), bits(hi)),
        "        nu: %s," % bits(nu),
        "    },",
    ]
lines.append("];")
out = os.path.join(SALIB, "crates", "salib-estimators", "tests", "oracles", "g_theory_f_interval.rs")
open(out, "w").write("\n".join(lines) + "\n")
print("ok: wrote %d pinned F-interval cases" % len(CASES))
