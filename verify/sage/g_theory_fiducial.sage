# Claims for salib's fiducial Phi interval (salib #10).
#
# 1. The expected mean squares of the balanced crossed p×i×r random model are
#    the table salib uses (`expected_mean_squares`). Derived here from the
#    expected T terms in crolib's balanced.sage (CASMA 21 Eq. 68), with
#    SS(e) = Σ_{β⊆e} (−1)^{|e|−|β|} T(β) and df(e) = Π_{f∈e} (n_f − 1).
# 2. Exact quantiles of the fiducial generalized pivotal quantity (Hannig, Iyer
#    & Patterson 2006, JASA 101:254, Theorem 2), R_j = SS_j/U_j with
#    U_j ~ χ²(df_j) independent, for two components:
#      σ²(pir) = R_pir, whose q quantile is SS_pir / χ²_{1−q}(df_pir);
#      σ²(pi) = (R_pi − R_pir)/n_r, whose cdf is the one-dimensional integral
#        P(σ²(pi) ≤ t) = E_{U_pir}[ Q(df_pi/2, SS_pi / (2(n_r t + SS_pir/U_pir))) ],
#      with Q the upper regularized gamma, by mpmath quadrature at 30 digits.
# Emits crates/salib-estimators/tests/oracles/g_theory_fiducial.rs.
import os, hashlib, struct, itertools, mpmath, sage.version
SALIB = os.environ["SALIB_ROOT"]
CROLIB = os.environ["CROLIB"]
load(os.path.join(CROLIB, "verify", "sage", "balanced.sage"))

facets = ['p', 'i', 'r']
var('n_p n_i n_r mu2')
sizes = {'p': n_p, 'i': n_i, 'r': n_r}
sigma = {e: var('s_' + ''.join(e)) for e in effects(facets)}

def expected_t(beta):
    return et_coefficient((), beta, facets, sizes) * mu2 + sum(
        et_coefficient(a, beta, facets, sizes) * sigma[a] for a in effects(facets))

def subsets(e):
    return [c for k in range(len(e) + 1) for c in itertools.combinations(e, k)]

ems = {}
for e in effects(facets):
    ess = sum((-1)^(len(e) - len(b)) * expected_t(b) for b in subsets(e))
    ems[e] = (ess / prod([sizes[f] - 1 for f in e])).simplify_full()

s = sigma
table = {  # salib's expected_mean_squares, in ALL order
    ('p',): s[('p','i','r')] + n_r*s[('p','i')] + n_i*s[('p','r')] + n_i*n_r*s[('p',)],
    ('i',): s[('p','i','r')] + n_r*s[('p','i')] + n_p*s[('i','r')] + n_p*n_r*s[('i',)],
    ('r',): s[('p','i','r')] + n_i*s[('p','r')] + n_p*s[('i','r')] + n_p*n_i*s[('r',)],
    ('p','i'): s[('p','i','r')] + n_r*s[('p','i')],
    ('p','r'): s[('p','i','r')] + n_i*s[('p','r')],
    ('i','r'): s[('p','i','r')] + n_p*s[('i','r')],
    ('p','i','r'): s[('p','i','r')],
}
for e in effects(facets):
    assert bool((ems[e] - table[e]).simplify_full() == 0), "EMS(%s) differs: %s" % (e, ems[e])
print("ok: expected mean squares match salib's table (derived from expected T terms)")

# --- Exact fiducial quantiles ---------------------------------------------
mpmath.mp.dps = 30
ORDER = [('p',), ('i',), ('r',), ('p','i'), ('p','r'), ('i','r'), ('p','i','r')]

def mean_squares(c, n):
    """EMS at the components, in mpmath from the exact f64 values Rust uses."""
    subs = {sigma[e]: c[k] for k, e in enumerate(ORDER)}
    subs.update({n_p: n[0], n_i: n[1], n_r: n[2]})
    vals = [QQ(table[e].subs(subs)) for e in ORDER]
    return [mpmath.mpf(int(v.numerator())) / int(v.denominator()) for v in vals]

def chi_quantile(prob, df):
    cdf = lambda x: mpmath.gammainc(df / 2, 0, x / 2, regularized=True)
    lo, hi = mpmath.mpf(0), mpmath.mpf(1)
    while cdf(hi) < prob:
        lo, hi = hi, hi * 2
    for _ in range(200):
        mid = (lo + hi) / 2
        if cdf(mid) < prob:
            lo = mid
        else:
            hi = mid
    return hi

def chi_density(u, df):
    return mpmath.exp((df / 2 - 1) * mpmath.log(u) - u / 2 - (df / 2) * mpmath.log(2) - mpmath.loggamma(df / 2))

def pi_cdf(t, ss_pi, df_pi, ss_pir, df_pir, nr):
    def integrand(u):
        y = nr * t + ss_pir / u
        if y <= 0:
            return mpmath.mpf(0)
        return chi_density(u, df_pir) * mpmath.gammainc(df_pi / 2, ss_pi / (2 * y), mpmath.inf, regularized=True)
    sd = mpmath.sqrt(2 * df_pir)
    pts = [max(mpmath.mpf(0), df_pir + int(k) * sd) for k in range(-14, 15, 2)]
    pts = sorted(set(pts))
    return mpmath.quad(integrand, pts)

def bisect(f, level, lo, hi):
    for _ in range(60):
        mid = (lo + hi) / 2
        if f(mid) < level:
            lo = mid
        else:
            hi = mid
    return hi

def bits(x):
    return "f64::from_bits(0x%016x)" % struct.unpack('<Q', struct.pack('<d', float(x)))[0]

LEVELS = ["0.025", "0.5", "0.975"]
CASES = [
    ([0.8, 0.3, 0.2, 1.0, 0.4, 0.3, 1.0], (20, 5, 3)),
    ([4.0, 0.5, 0.5, 0.5, 0.5, 0.5, 0.5], (12, 6, 2)),
]
lines = [
    "// @generated by verify/sage/g_theory_fiducial.sage — do not edit.",
    "// sha256(script) = %s; SageMath %s" % (hashlib.sha256(open(os.path.join(SALIB, "verify", "sage", "g_theory_fiducial.sage"), "rb").read()).hexdigest(), sage.version.version),
    "// Fiducial GPQ quantiles: closed form for σ²(pir), mpmath quadrature for σ²(pi), 30 digits.",
    "",
    "/// Components, counts and exact (component index, level, quantile) triples.",
    "pub struct FiducialCase {",
    "    pub components: [f64; 7],",
    "    pub sizes: [usize; 3],",
    "    pub quantiles: &'static [(usize, f64, f64)],",
    "}",
    "",
    "pub const FIDUCIAL_CASES: &[FiducialCase] = &[",
]
for comps, n in CASES:
    c = [QQ(float(v)) for v in comps]   # the exact f64 values
    ms = mean_squares(c, n)
    df = [mpmath.mpf(int(v)) for v in (n[0]-1, n[1]-1, n[2]-1, (n[0]-1)*(n[1]-1), (n[0]-1)*(n[2]-1), (n[1]-1)*(n[2]-1), (n[0]-1)*(n[1]-1)*(n[2]-1))]
    ss = [ms[j] * df[j] for j in range(7)]
    triples = []
    for lv in LEVELS:
        q = mpmath.mpf(lv)
        triples.append((6, lv, ss[6] / chi_quantile(1 - q, df[6])))
    nr = mpmath.mpf(int(n[2]))
    centre = (ms[3] - ms[6]) / nr
    for lv in LEVELS:
        q = mpmath.mpf(lv)
        f = lambda t: pi_cdf(t, ss[3], df[3], ss[6], df[6], nr)
        lo, hi = mpmath.mpf(0), centre
        while f(hi) < q:
            hi *= 2
        triples.append((3, lv, bisect(f, q, lo, hi)))
    lines += ["    FiducialCase {",
              "        components: [%s]," % ", ".join(repr(float(v)) for v in comps),
              "        sizes: [%d, %d, %d]," % n,
              "        quantiles: &[%s]," % ", ".join("(%d, %s, %s)" % (k, lv, bits(v)) for k, lv, v in triples),
              "    },"]
lines.append("];")
open(os.path.join(SALIB, "crates", "salib-estimators", "tests", "oracles", "g_theory_fiducial.rs"), "w").write("\n".join(lines) + "\n")
print("ok: wrote %d fiducial cases" % len(CASES))
