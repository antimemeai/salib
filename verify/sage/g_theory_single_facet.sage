# Claim: for each single-facet bootstrap plan of the crossed p×i×r design,
# Brennan's corrected replicates (CASMA 21) centre exactly on the observed
# ANOVA estimates, conditional on the data; their exact variance over all
# resamples is the quantity a bootstrap SE estimates.
#
# Method: crolib's balanced.sage solves the boot-λ expected-T-term system
# (CASMA 21 Eq. 70) for every resample of small rational grids, enumerating
# all n_j^n_j redraws. Emits crates/salib-estimators/tests/oracles/
# g_theory_single_facet.rs: grid data, the observed estimates and the exact
# replicate variance per (grid, facet, component), as correctly rounded f64.
import os, hashlib, struct, sage.version
# Sage runs a preparsed copy from a temp directory, so locations come from the
# runner (scripts/sage-check.sh), which sets SALIB_ROOT and CROLIB.
SALIB = os.environ["SALIB_ROOT"]
CROLIB = os.environ.get("CROLIB", os.path.join(SALIB, "..", "crolib"))
load(os.path.join(CROLIB, "verify", "sage", "balanced.sage"))

FACETS = ('p', 'i', 'r')
ORDER = [('p',), ('i',), ('r',), ('p', 'i'), ('p', 'r'), ('i', 'r'), ('p', 'i', 'r')]
R53 = RealField(53, rnd='RNDN')

def f64_bits(q):
    return "f64::from_bits(0x%016x)" % int(struct.unpack('<Q', struct.pack('<d', float(R53(q))))[0])

cases = []
set_random_seed(20261023)
for shape in [(3, 2, 2), (2, 3, 2), (2, 2, 3), (3, 3, 2)]:
    sizes = dict(zip(FACETS, shape))
    cells = list(itertools.product(*[range(n) for n in shape]))
    y = {c: QQ(ZZ.random_element(0, 10)) for c in cells}
    base = estimate(y, FACETS, sizes)
    for facet in FACETS:
        reps = [estimate(apply_resample(y, FACETS, sizes, facet, d), FACETS, sizes, boot=(facet,))
                for d in resamples(FACETS, sizes, facet)]
        m = len(reps)
        mean = {a: sum(r[a] for r in reps) / m for a in ORDER}
        var = {a: sum((r[a] - mean[a])^2 for r in reps) / m for a in ORDER}
        assert all(mean[a] == base[a] for a in ORDER), (shape, facet)
        cases.append((shape, [y[c] for c in cells], facet, [base[a] for a in ORDER], [var[a] for a in ORDER], m))

script = open(os.path.join(SALIB, "verify", "sage", "g_theory_single_facet.sage"), "rb").read()
lines = [
    "// @generated by verify/sage/g_theory_single_facet.sage — do not edit.",
    "// sha256(script) = %s; SageMath %s" % (hashlib.sha256(script).hexdigest(), sage.version.version),
    "// Exact oracle: Brennan (2006, CASMA 21) boot-λ T-term system, every resample enumerated.",
    "",
    "/// One grid, one single-facet plan: data in (p, i, r) row-major order, the observed",
    "/// estimates, and the exact variance of corrected replicates over all `resamples`.",
    "pub struct SingleFacetCase {",
    "    pub shape: (usize, usize, usize),",
    "    pub data: &'static [f64],",
    "    pub facet: char,",
    "    pub estimates: [f64; 7],",
    "    pub replicate_variance: [f64; 7],",
    "    pub resamples: usize,",
    "}",
    "",
    "pub const SINGLE_FACET_CASES: &[SingleFacetCase] = &[",
]
for shape, data, facet, est, var, m in cases:
    lines.append("    SingleFacetCase {")
    lines.append("        shape: (%d, %d, %d)," % shape)
    lines.append("        data: &[%s]," % ", ".join("%d.0" % int(v) for v in data))
    lines.append("        facet: '%s'," % facet)
    lines.append("        estimates: [%s]," % ", ".join(f64_bits(v) for v in est))
    lines.append("        replicate_variance: [%s]," % ", ".join(f64_bits(v) for v in var))
    lines.append("        resamples: %d," % m)
    lines.append("    },")
lines.append("];")
out = os.path.join(SALIB, "crates", "salib-estimators", "tests", "oracles", "g_theory_single_facet.rs")
os.makedirs(os.path.dirname(out), exist_ok=True)
open(out, "w").write("\n".join(lines) + "\n")
print("ok: %d (grid, facet) cases; corrected replicates centre exactly; wrote %s" % (len(cases), os.path.relpath(out, SALIB)))
