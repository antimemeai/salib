# Claim: salib-validation's closed-form Sobol' indices for the Ishigami and
# Sobol' G functions equal the variance decomposition of each function's own
# definition. Derived here by symbolic integration over the input space
# (Hoeffding/ANOVA decomposition), not from published closed forms.
# Emits crates/salib-validation/tests/oracles/analytic_indices.rs.
import os, hashlib, struct, itertools, sage.version
SALIB = os.environ["SALIB_ROOT"]
R = RealField(256)

def exact_double(x):
    """The exact rational value of the f64 nearest x, which is what Rust receives."""
    n, d = float(x).as_integer_ratio()
    return QQ(Integer(n)) / QQ(Integer(d))

def bits(x):
    return "f64::from_bits(0x%016x)" % struct.unpack('<Q', struct.pack('<d', float(RealField(53)(R(x)))))[0]

# ---- Ishigami: f = sin x1 + a sin^2 x2 + b x3^4 sin x1, x ~ U(-pi, pi)^3 ----
var('x1 x2 x3 a b')
X = [x1, x2, x3]
f = sin(x1) + a * sin(x2)^2 + b * x3^4 * sin(x1)
def mean_over(expr, vs):
    for v in vs:
        expr = integrate(expr, v, -pi, pi) / (2 * pi)
    return expr.simplify_full()
mu = mean_over(f, X)
D = (mean_over(f^2, X) - mu^2).simplify_full()
def cond_var(keep):
    """Var(E[f | x_keep]): closed variance, before Möbius inversion."""
    others = [v for v in X if v not in keep]
    g = mean_over(f, others) if others else f
    return (mean_over(g^2, keep) - mu^2).simplify_full()
closed = {k: cond_var([X[i] for i in k]) for n in (1, 2) for k in itertools.combinations(range(3), n)}
V1 = [closed[(i,)] for i in range(3)]
V2 = {k: (closed[k] - closed[(k[0],)] - closed[(k[1],)]).simplify_full() for k in itertools.combinations(range(3), 2)}
VT = [(D - cond_var([X[j] for j in range(3) if j != i])).simplify_full() for i in range(3)]
ishigami_cases = [(exact_double(av), exact_double(bv)) for av, bv in [(7, 0.1), (5, 0.2), (0, 0), (1, 0), (0, 1), (2, 0.5)]]

# ---- Sobol' G: g = prod (|4 x_i - 2| + a_i)/(1 + a_i), x ~ U(0,1)^d ----
var('x')
def g_factor_moments(ai):
    h = (abs(4 * x - 2) + ai) / (1 + ai)
    m1 = integrate(h, x, 0, 1).simplify_full()
    m2 = integrate(h^2, x, 0, 1).simplify_full()
    return m1, (m2 - m1^2).simplify_full()
# For a product of independent factors h_i with E h_i = 1 (asserted below),
# the Hoeffding decomposition gives V_u = prod_{i in u} Var(h_i) exactly.
# That is the same product structure the Rust code uses, so the small cases
# are also derived without it (sobol_g_direct) and the two must agree exactly.
def sobol_g(avec):
    vs = []
    for ai in avec:
        m1, vi = g_factor_moments(ai)
        assert m1 == 1, (ai, m1)
        vs.append(vi)
    Dg = prod(1 + v for v in vs) - 1
    S = [v / Dg for v in vs]
    ST = [v * prod(1 + w for j, w in enumerate(vs) if j != i) / Dg for i, v in enumerate(vs)]
    return Dg, S, ST
def sobol_g_direct(avec):
    """D, S_i and S_Ti by integrating the full product g over U(0,1)^d:
    D = E g² − 1, S_i = Var E[g|x_i]/D, S_Ti = (D − Var E[g|x_~i])/D."""
    xs = [var('y%d' % k) for k in range(len(avec))]
    g = prod((abs(4 * v - 2) + ai) / (1 + ai) for v, ai in zip(xs, avec))
    def mean(expr, vs):
        for v in vs:
            expr = integrate(expr, v, 0, 1)
        return expr.simplify_full()
    mu = mean(g, xs)
    assert mu == 1
    Dg = mean(g^2, xs) - 1
    S, ST = [], []
    for i, xi in enumerate(xs):
        others = [v for v in xs if v is not xi]
        S.append((mean(mean(g, others)^2, [xi]) - 1) / Dg)
        ST.append((Dg - (mean(mean(g, [xi])^2, others) - 1)) / Dg)
    return Dg, S, ST

g_cases = [[0, 1, 4.5, 9, 99, 99, 99, 99], [0, 0, 0], [99, 99, 99, 99], [0.5, 3, 25], [0, 1], [7], [0] * 50, [0] * 500]
g_cases = [[exact_double(v) for v in avec] for avec in g_cases]
for avec in g_cases:
    if len(avec) <= 3:
        assert sobol_g_direct(avec) == sobol_g(avec), avec

lines = [
    "// @generated by verify/sage/validation_analytic.sage — do not edit.",
    "// sha256(script) = %s; SageMath %s" % (hashlib.sha256(open(os.path.join(SALIB, "verify", "sage", "validation_analytic.sage"), "rb").read()).hexdigest(), sage.version.version),
    "// Exact Sobol' decompositions: Ishigami and Sobol' G cases with d <= 3 by integrating each function's definition; larger Sobol' G cases by its Hoeffding product form.",
    "",
    "/// Ishigami: (a, b), D, S_i, S_Ti, and S2 in salib's upper-triangle order",
    "/// (S2_01, S2_02, S2_12).",
    "pub struct IshigamiCase {",
    "    pub a: f64,",
    "    pub b: f64,",
    "    pub total_variance: f64,",
    "    pub first_order: [f64; 3],",
    "    pub total_order: [f64; 3],",
    "    pub second_order: [f64; 3],",
    "}",
    "",
    "/// Sobol' G: a vector, D, S_i and S_Ti.",
    "pub struct SobolGCase {",
    "    pub a: &'static [f64],",
    "    pub total_variance: f64,",
    "    pub first_order: &'static [f64],",
    "    pub total_order: &'static [f64],",
    "}",
    "",
    "pub const ISHIGAMI_CASES: &[IshigamiCase] = &[",
]
for av, bv in ishigami_cases:
    sub = {a: av, b: bv}
    Dv = D.subs(sub)
    s1 = [(v.subs(sub) / Dv) for v in V1]
    st = [(v.subs(sub) / Dv) for v in VT]
    s2 = [(V2[k].subs(sub) / Dv) for k in [(0, 1), (0, 2), (1, 2)]]
    lines += [
        "    IshigamiCase {",
        "        a: %r," % float(av), "        b: %r," % float(bv),
        "        total_variance: %s," % bits(Dv),
        "        first_order: [%s]," % ", ".join(bits(v) for v in s1),
        "        total_order: [%s]," % ", ".join(bits(v) for v in st),
        "        second_order: [%s]," % ", ".join(bits(v) for v in s2),
        "    },",
    ]
lines += ["];", "", "pub const SOBOL_G_CASES: &[SobolGCase] = &["]
for avec in g_cases:
    Dg, S, ST = sobol_g(avec)
    lines += [
        "    SobolGCase {",
        "        a: &[%s]," % ", ".join(repr(float(v)) for v in avec),
        "        total_variance: %s," % bits(Dg),
        "        first_order: &[%s]," % ", ".join(bits(v) for v in S),
        "        total_order: &[%s]," % ", ".join(bits(v) for v in ST),
        "    },",
    ]
lines.append("];")

# ---- Ishigami function and gradient at fixed points (derived by Sage) ----
grad = [diff(f, v) for v in X]
def terms(expr):
    e = expr.expand()
    return e.operands() if e.operator() is operator.add else [e]
import operator
R200 = RealField(200)
points = [(0.3, -1.2, 2.5), (-2.9, 0.7, -0.4), (1.5707963267948966, 3.0, 3.1), (0.0, -3.14, 1.0)]
params = [(7.0, 0.1), (5.0, 0.2), (2.0, 0.5)]
lines += ["", "/// Ishigami value and gradient at (x1, x2, x3) for (a, b), with the sum of the",
          "/// absolute additive terms of each output (its rounding scale).",
          "pub struct IshigamiPoint {", "    pub a: f64,", "    pub b: f64,", "    pub x: [f64; 3],",
          "    pub value: f64,", "    pub value_scale: f64,", "    pub gradient: [f64; 3],",
          "    pub gradient_scale: [f64; 3],", "}", "", "pub const ISHIGAMI_POINTS: &[IshigamiPoint] = &["]
for av, bv in params:
    for pt in points:
        sub = {a: exact_double(av), b: exact_double(bv), x1: exact_double(pt[0]), x2: exact_double(pt[1]), x3: exact_double(pt[2])}
        val = lambda e: R200(e.subs(sub))
        scale = lambda e: sum(abs(R200(t.subs(sub))) for t in terms(e))
        lines += ["    IshigamiPoint {",
                  # Inputs as exact bit patterns: Sage's preparser can print
                  # fewer digits than the double it evaluated.
                  "        a: %s," % bits(exact_double(av)), "        b: %s," % bits(exact_double(bv)),
                  "        x: [%s]," % ", ".join(bits(exact_double(v)) for v in pt),
                  "        value: %s," % bits(val(f)), "        value_scale: %s," % bits(scale(f)),
                  "        gradient: [%s]," % ", ".join(bits(val(g)) for g in grad),
                  "        gradient_scale: [%s]," % ", ".join(bits(scale(g)) for g in grad),
                  "    },"]
lines.append("];")
out = os.path.join(SALIB, "crates", "salib-validation", "tests", "oracles", "analytic_indices.rs")
os.makedirs(os.path.dirname(out), exist_ok=True)
open(out, "w").write("\n".join(lines) + "\n")
print("ok: Ishigami D =", D, "; wrote %d Ishigami and %d Sobol' G cases" % (len(ishigami_cases), len(g_cases)))
